# Copy to .env. This file contains no real secrets.
# Legacy LAN URL: ../gradle.properties BACKEND_BASE_URL.
# Accounts: set AUTH_PUBLIC_BASE_URL here and matching AUTH_BASE_URL in Gradle.
HOST=0.0.0.0
PORT=8787

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=green_farm
DB_USER=green_farm_app
DB_PASSWORD=
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT_MS=5000

# Generate a private random value once; keep it stable across server restarts.
# Never commit this value. At least 32 UTF-8 bytes are required.
RESEARCH_SESSION_SECRET=
SESSION_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000

# Embedded username/password accounts and official browser OAuth share this HTTPS origin.
# Password login needs no Google/Facebook credentials. See EMBEDDED_AUTH.md for
# future HTTPS hosting or a named Cloudflare Tunnel; no tunnel is deployed here.
# Configure a real HTTPS origin behind a TLS reverse proxy; leave blank until ready.
AUTH_PUBLIC_BASE_URL=
# Only this exact proxy peer may assert X-Forwarded-Proto=https and one client IP.
# Reverse proxy must overwrite both forwarded headers, never append incoming values.
AUTH_TRUSTED_PROXY_IP=127.0.0.1
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The original Facebook button still uses official browser OAuth, never WebView.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v24.0
# Keep false for social-account deployments. Legacy anonymous API is research-only.
LEGACY_AUTH_ENABLED=false
