# Copy to .env. This file contains no real secrets.
# The app/server URL is configured ONLY in ../gradle.properties BACKEND_BASE_URL.
HOST=0.0.0.0
PORT=8787

# Resolved relative to backend/, independent of the current working directory.
# Not RAM or a temporary directory. Never put this file under a public web root.
SQLITE_PATH=./data/green-farm.sqlite
SQLITE_BUSY_TIMEOUT_MS=100
MAX_SNAPSHOT_BYTES=16777216
# Optional alternate defaults JSON for an isolated instance, not an app URL.
# NEW_PLAYER_DEFAULTS_FILE=./config/new_player_defaults.json

# Generate a private random value once; keep it stable across server restarts.
# Never commit this value. At least 32 UTF-8 bytes are required.
RESEARCH_SESSION_SECRET=
SESSION_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
GUEST_SESSION_TTL_SECONDS=2592000

# DB_* are ONLY used by the optional explicit export-mysql migration command.
# Existing MySQL records are never reset or silently adopted as guest profiles.
