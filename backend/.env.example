# Copy to backend/.env only if it does not already exist. Fill in local values.
# Process environment values take precedence over this file.
HOST=0.0.0.0
PORT=8787
# Legacy discovery reads BACKEND_BASE_URL in the root gradle.properties.
# BACKEND_CONFIG_FILE=/absolute/path/to/gradle.properties

# Use a dedicated MySQL account with grants to this database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=green_farm
DB_USER=green_farm_app
DB_PASSWORD=
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT_MS=5000

# Enable anonymous legacy sessions only for development/research.
LEGACY_AUTH_ENABLED=false
# When legacy sessions are enabled, set a private random value of at least
# 32 UTF-8 bytes and keep it stable across restarts.
RESEARCH_SESSION_SECRET=
SESSION_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000

# Set the HTTPS auth origin and match it to AUTH_BASE_URL in Android Gradle.
# Leave blank to run without browser accounts and giftcodes.
AUTH_PUBLIC_BASE_URL=
# If using a reverse proxy, set its exact peer IP, for example 127.0.0.1.
# The proxy must overwrite X-Forwarded-Proto and X-Forwarded-For.
AUTH_TRUSTED_PROXY_IP=

# Optional provider ID/secret pairs. Website accounts work without them.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v24.0

# Set the Argon2id hash to enable /admin/giftcodes. See ../docs/GIFTCODES.md.
GIFTCODE_ADMIN_PASSWORD_HASH=
