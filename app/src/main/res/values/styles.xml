<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppBaseTheme" parent="@android:style/Theme.Light">
    </style>
    <style name="AppTheme" parent="@style/AppBaseTheme">
    </style>
    <style name="IapProgressBar" parent="@android:style/Widget.ProgressBar">
        <item name="android:maxWidth">26dp</item>
        <item name="android:maxHeight">26dp</item>
        <item name="android:indeterminateDrawable">@drawable/progressbar_middle</item>
        <item name="android:minWidth">26dp</item>
        <item name="android:minHeight">26dp</item>
    </style>
    <style name="Theme.Empty" parent="@style/AppTheme">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>
    <style name="Theme_Dialog_Custom" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="com_facebook_auth_dialog_instructions_textview" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:typeface">1</item>
        <item name="android:textColor">@color/com_facebook_device_auth_text</item>
        <item name="android:gravity">0x11</item>
        <item name="android:layout_width">-2</item>
        <item name="android:layout_height">-2</item>
        <item name="android:singleLine">false</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:fontFamily">roboto</item>
    </style>
    <style name="com_facebook_button" parent="@android:style/Widget.Button">
        <item name="android:textSize">14dp</item>
        <item name="android:textColor">@color/com_facebook_button_text_color</item>
        <item name="android:gravity">0x11</item>
        <item name="android:background">@drawable/com_facebook_button_background</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:drawablePadding">6dp</item>
    </style>
    <style name="com_facebook_auth_dialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
    <style name="com_facebook_button_like" parent="@style/com_facebook_button">
        <item name="android:background">@drawable/com_facebook_button_like_background</item>
    </style>
    <style name="com_facebook_activity_theme" parent="@android:style/Theme.Holo.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
    <style name="tooltip_bubble_text" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:gravity">0x3</item>
        <item name="android:shadowColor">#40000000</item>
        <item name="android:shadowDy">-1</item>
        <item name="android:shadowRadius">0.25</item>
    </style>
    <style name="com_facebook_loginview_silver_style" parent="@style/com_facebook_loginview_default_style">
        <item name="android:textColor">#4b5164</item>
        <item name="android:background">@drawable/com_facebook_button_login_silver_background</item>
        <item name="android:drawableLeft">@null</item>
    </style>
    <style name="com_facebook_loginview_default_style" parent="@style/com_facebook_button">
        <item name="android:textSize">13dp</item>
        <item name="android:background">@drawable/com_facebook_button_login_background</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:drawablePadding">5dp</item>
    </style>
    <style name="com_facebook_button_send" parent="@style/com_facebook_button">
        <item name="android:textColor">@color/com_facebook_send_button_text_color</item>
        <item name="android:background">@drawable/com_facebook_button_send_background</item>
        <item name="android:text">@string/com_facebook_send_button_text</item>
        <item name="android:drawableLeft">@drawable/com_facebook_send_button_icon</item>
    </style>
    <style name="com_facebook_button_share" parent="@style/com_facebook_button">
        <item name="android:text">@string/com_facebook_share_button_text</item>
        <item name="android:drawableLeft">@drawable/com_facebook_button_icon</item>
    </style>
    <style name="CardView" parent="@style/Base.CardView">
    </style>
    <style name="Base.CardView" parent="@android:style/Widget">
        <item name="cardCornerRadius">@dimen/cardview_default_radius</item>
        <item name="cardElevation">@dimen/cardview_default_elevation</item>
        <item name="cardMaxElevation">@dimen/cardview_default_elevation</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="cardPreventCornerOverlap">true</item>
    </style>
    <style name="CardView.Dark" parent="@style/CardView">
        <item name="cardBackgroundColor">@color/cardview_dark_background</item>
    </style>
    <style name="CardView.Light" parent="@style/CardView">
        <item name="cardBackgroundColor">@color/cardview_light_background</item>
    </style>
    <style name="Theme.IAPTheme" parent="@android:style/Theme">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    <style name="processbar_downloading" parent="@style/Theme.wrapper.progressbar.horizontal">
        <item name="android:layout_gravity">0x51</item>
        <item name="android:layout_width">@dimen/downloading_processbar_width</item>
        <item name="android:layout_height">@dimen/downloading_processbar_height</item>
        <item name="android:indeterminate">false</item>
        <item name="android:progressDrawable">@drawable/style_progressbar_downloading</item>
    </style>
    <style name="processtext_downloading_extra_style" parent="">
        <item name="android:typeface">0</item>
        <item name="android:textStyle">0x0</item>
    </style>
    <style name="processtext_downloading" parent="@style/processtext_downloading_extra_style">
        <item name="android:textColor">@android:color/black</item>
        <item name="android:layout_gravity">0x11</item>
        <item name="android:layout_width">-2</item>
        <item name="android:layout_height">-2</item>
    </style>
    <style name="Theme.wrapper.black.notitlebar.fullscreen" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
    </style>
    <style name="NoBorderDialogTheme" parent="">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="NoFullscreenDialogTheme" parent="">
        <item name="android:windowFullscreen">false</item>
    </style>
    <style name="Theme.wrapper.translucent.notitlebar" parent="@android:style/Theme.Translucent.NoTitleBar">
    </style>
    <style name="Theme.wrapper.translucent.notitlebar.fullscreen" parent="@android:style/Theme.Translucent.NoTitleBar.Fullscreen">
    </style>
    <style name="Theme.wrapper.notitlebar.fullscreen" parent="@android:style/Theme.NoTitleBar.Fullscreen">
    </style>
    <style name="Theme.wrapper.notitlebar" parent="@android:style/Theme.NoTitleBar">
    </style>
    <style name="Theme.wrapper.progressbar.horizontal" parent="@android:style/Widget.ProgressBar.Horizontal">
    </style>
    <style name="Theme.wrapper.progressbar" parent="@android:style/Widget.ProgressBar">
    </style>
</resources>
