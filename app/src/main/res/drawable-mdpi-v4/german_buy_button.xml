<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:startColor="#ffd8fbd5"
                android:endColor="#ff91eb96"
                android:angle="270"/>
            <padding
                android:left="10dp"
                android:top="10dp"
                android:right="10dp"
                android:bottom="10dp"/>
            <corners android:radius="3dp"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <gradient
                android:startColor="#ffd8fbd5"
                android:endColor="#ff91eb96"
                android:angle="270"/>
            <padding
                android:left="10dp"
                android:top="10dp"
                android:right="10dp"
                android:bottom="10dp"/>
            <corners android:radius="3dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:startColor="#ff8dde87"
                android:endColor="#ff04960b"
                android:angle="270"/>
            <padding
                android:left="10dp"
                android:top="10dp"
                android:right="10dp"
                android:bottom="10dp"/>
            <corners android:radius="3dp"/>
        </shape>
    </item>
</selector>
